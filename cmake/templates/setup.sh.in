#!/bin/sh
# Source this file to use this arnold-usd installation:
#
#     . <this folder>/setup.sh
#
# This install was built against a shared/monolithic USD, so its plugins (Hydra render
# delegate, node registry, USD schemas) are not embedded in a procedural and have to be
# found at runtime. This script wires up the Arnold and USD locations it was built
# against, then hands off to that USD's own setup.sh for its python interpreter and
# command line tools. Everything belonging to this install is resolved relative to this
# script's own location, so the install itself stays relocatable; only the external
# Arnold and USD locations below are baked in at configure time.
#
# Generated by cmake, see CMakeLists.txt.

# Locating ourselves, and telling whether we are being sourced, has to be done differently
# in each shell, and the syntax of one is a parse error in the other, hence the evals.
_arnold_usd_sourced=1
if [ -n "${ZSH_VERSION:-}" ]; then
    _arnold_usd_setup=$(eval 'printf %s "${(%):-%x}"')
    case "${ZSH_EVAL_CONTEXT:-}" in
        *file*) ;;
        *) _arnold_usd_sourced=0 ;;
    esac
elif [ -n "${BASH_VERSION:-}" ]; then
    _arnold_usd_setup=$(eval 'printf %s "${BASH_SOURCE[0]}"')
    [ "$_arnold_usd_setup" = "$0" ] && _arnold_usd_sourced=0
else
    _arnold_usd_setup="$0"
fi

if [ "$_arnold_usd_sourced" = 0 ]; then
    echo "setup.sh sets up the environment of the current shell, it has to be sourced:" >&2
    echo "    . $_arnold_usd_setup" >&2
    unset _arnold_usd_setup _arnold_usd_sourced
    exit 1
fi
unset _arnold_usd_sourced

_arnold_usd_root=$(cd "$(dirname "$_arnold_usd_setup")" && pwd)
export ARNOLD_USD_ROOT="$_arnold_usd_root"
unset _arnold_usd_setup

# Arnold on the PATH first, so the USD setup.sh sourced below detects it (via `kick`)
# and wires up its own python bindings.
_arnold_usd_arnold_location="@ARNOLD_LOCATION@"
if [ -d "$_arnold_usd_arnold_location/bin" ]; then
    case ":$PATH:" in
        *":$_arnold_usd_arnold_location/bin:"*) ;;
        *) PATH="$_arnold_usd_arnold_location/bin:$PATH" ; export PATH ;;
    esac
fi
unset _arnold_usd_arnold_location

# The shared USD this was built against: its own setup.sh puts its bundled python
# interpreter and command line tools on the PATH.
_arnold_usd_usd_setup="@USD_LOCATION@/setup.sh"
if [ -f "$_arnold_usd_usd_setup" ]; then
    . "$_arnold_usd_usd_setup"
else
    echo "arnold-usd setup.sh: no setup.sh found at $_arnold_usd_usd_setup, PATH/python not configured" >&2
fi
unset _arnold_usd_usd_setup

# Arnold's Hydra render delegate, node registry and USD schemas, registered through
# USD's plugin path. This build's pxrConfig.cmake renamed the variable Plug uses, see
# USD_OVERRIDE_PLUGINPATH_NAME in cmake/utils/options.cmake.
_arnold_usd_plugin_dirs="@ARNOLD_USD_SETUP_PLUGIN_DIRS@"
if [ -n "$_arnold_usd_plugin_dirs" ]; then
    case ":${@USD_OVERRIDE_PLUGINPATH_NAME@:-}:" in
        *":$_arnold_usd_plugin_dirs:"*) ;;
        *)
            @USD_OVERRIDE_PLUGINPATH_NAME@="$_arnold_usd_plugin_dirs${@USD_OVERRIDE_PLUGINPATH_NAME@:+:$@USD_OVERRIDE_PLUGINPATH_NAME@}"
            export @USD_OVERRIDE_PLUGINPATH_NAME@
            ;;
    esac
fi
unset _arnold_usd_plugin_dirs

# The Arnold procedural, if this install was built with a standalone one (bundle builds
# embed it in the Hydra plugin above instead, so this is empty for them).
_arnold_usd_procedural_dir="@ARNOLD_USD_SETUP_PROCEDURAL_DIR@"
if [ -n "$_arnold_usd_procedural_dir" ]; then
    case ":${ARNOLD_PLUGIN_PATH:-}:" in
        *":$_arnold_usd_procedural_dir:"*) ;;
        *) ARNOLD_PLUGIN_PATH="$_arnold_usd_procedural_dir${ARNOLD_PLUGIN_PATH:+:$ARNOLD_PLUGIN_PATH}" ; export ARNOLD_PLUGIN_PATH ;;
    esac
fi
unset _arnold_usd_procedural_dir

unset _arnold_usd_root
